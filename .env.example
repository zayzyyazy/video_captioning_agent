FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_AUDIO_BASE_URL=https://audio-turbo.us-virginia-1.direct.fireworks.ai/v1
FIREWORKS_WHISPER_MODEL=whisper-v3-turbo
ENABLE_TRANSCRIPTION=1
# Current Fireworks serverless VLMs (qwen2p5-vl-* returns 404 on serverless)
FIREWORKS_VLM_MODEL=accounts/fireworks/models/kimi-k2p6
FIREWORKS_LLM_MODEL=accounts/fireworks/models/qwen3p7-plus
MAX_FRAMES=16
MAX_PARALLEL_TASKS=3
